<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyNotes.Views.NoteEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:l="using:WinUI3Localizer"
    mc:Ignorable="d">

    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" x:Name="header" BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}" BorderThickness="0,0,0,1" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock l:Uids.Uid="NoteEditor_PageHeader" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="DeleteButton" MaxHeight="26" Padding="6,2" Margin="0,0,0,-1" Background="Transparent" CornerRadius="4,4,0,0" BorderThickness="1,1,1,0" BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}" l:Uids.Uid="TaskListEditor_DeleteButton">
                    <FontIcon Glyph="&#xE74D;"/>
                    <Button.Flyout>
                        <Flyout x:Name="DeleteFlyout">
                            <StackPanel MaxWidth="420">
                                <TextBlock l:Uids.Uid="NoteEditor_DeleteFlyout" Style="{ThemeResource BaseTextBlockStyle}" Margin="0,0,0,16" />
                                <Button l:Uids.Uid="DeleteConfirm" Click="DeleteButton_Click"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Padding="0,8,0,0" >

            <!-- Content -->
            <RelativePanel Width="auto" Height="auto" HorizontalAlignment="Stretch">
                <RelativePanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style TargetType="RichEditBox">
                        <Setter Property="CornerRadius" Value="4" />
                        <Setter Property="Margin" Value="0,0,0,48" />
                    </Style>
                </RelativePanel.Resources>

                <!-- Title -->
                <TextBox x:Name="TitleTextBox"
                             RelativePanel.AlignTopWithPanel="True"
                             RelativePanel.AlignLeftWithPanel="True"
                             RelativePanel.AlignRightWithPanel="True"
                             Margin="0,0,0,8"
                         Text="{x:Bind ViewModel.Title, Mode=TwoWay}"/>

                <Button x:Name="BoldButton" IsTabStop="False" Click="BoldButton_Click" RelativePanel.Below="TitleTextBox">
                    <Button.Content>
                        <FontIcon Glyph="&#xE8DD;"/>
                    </Button.Content>
                </Button>
                <Button x:Name="ItalicButton" IsTabStop="False" Click="ItalicButton_Click" RelativePanel.RightOf="BoldButton" RelativePanel.Below="TitleTextBox">
                    <Button.Content>
                        <FontIcon Glyph="&#xE8DB;"/>
                    </Button.Content>
                </Button>
                <Button x:Name="UnderlineButton" IsTabStop="False" Click="UnderlineButton_Click" RelativePanel.RightOf="ItalicButton" RelativePanel.Below="TitleTextBox">
                    <Button.Content>
                        <FontIcon Glyph="&#xE8DC;"/>
                    </Button.Content>
                </Button>
                <Button x:Name="StrikeButton" IsTabStop="False" Click="StrikeButton_Click" RelativePanel.RightOf="UnderlineButton" RelativePanel.Below="TitleTextBox">
                    <Button.Content>
                        <FontIcon Glyph="&#xEDE0;"/>
                    </Button.Content>
                </Button>

                <DropDownButton x:Name="ListButton" 
                Background="Transparent"
                BorderThickness="0" 
                IsTabStop="False" 
                RelativePanel.RightOf="StrikeButton"
                                     RelativePanel.Below="TitleTextBox">
                    <FontIcon Glyph="&#xE8FD;" />
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2">
                                <VariableSizedWrapGrid.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Padding" Value="6"/>
                                        <Setter Property="Width" Value="32"/>
                                        <Setter Property="Height" Value="32"/>
                                        <Setter Property="Margin" Value="4"/>
                                    </Style>
                                </VariableSizedWrapGrid.Resources>
                                <!-- Unordered -->
                                <Button Click="ListButton_Click" IsTabStop="False" CommandParameter="2">
                                    <Button.Content>
                                        <TextBlock Text="."/>
                                    </Button.Content>
                                </Button>
                                <!-- Arabic -->
                                <Button Click="ListButton_Click" IsTabStop="False" CommandParameter="3">
                                    <Button.Content>
                                        <TextBlock Text="1"/>
                                    </Button.Content>
                                </Button>
                                <!-- Lover Case English -->
                                <Button Click="ListButton_Click" IsTabStop="False" CommandParameter="4">
                                    <Button.Content>
                                        <TextBlock Text="a"/>
                                    </Button.Content>
                                </Button>
                                <!-- Upper Case English -->
                                <Button Click="ListButton_Click" IsTabStop="False" CommandParameter="5">
                                    <Button.Content>
                                        <TextBlock Text="A"/>
                                    </Button.Content>
                                </Button>
                                <!-- Lover Case Roman -->
                                <Button Click="ListButton_Click" IsTabStop="False" CommandParameter="6">
                                    <Button.Content>
                                        <TextBlock Text="i"/>
                                    </Button.Content>
                                </Button>
                                <!-- Upper Case Roman -->
                                <Button Click="ListButton_Click" IsTabStop="False" CommandParameter="7">
                                    <Button.Content>
                                        <TextBlock Text="I"/>
                                    </Button.Content>
                                </Button>
                            </VariableSizedWrapGrid>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <DropDownButton x:Name="AlignButton" BorderThickness="0" Background="Transparent"
                    IsTabStop="False" RelativePanel.RightOf="ListButton" RelativePanel.Below="TitleTextBox">
                    <SymbolIcon Symbol="AlignCenter"/>
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4">
                                <VariableSizedWrapGrid.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Padding" Value="6"/>
                                        <Setter Property="MinWidth" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                        <Setter Property="Margin" Value="4"/>
                                    </Style>
                                </VariableSizedWrapGrid.Resources>
                                <Button Click="AlignButton_Click" IsTabStop="False" CommandParameter="1">
                                    <Button.Content>
                                        <SymbolIcon Symbol="AlignLeft"/>
                                    </Button.Content>
                                </Button>
                                <Button Click="AlignButton_Click" IsTabStop="False" CommandParameter="2">
                                    <Button.Content>
                                        <SymbolIcon Symbol="AlignCenter"/>
                                    </Button.Content>
                                </Button>
                                <Button Click="AlignButton_Click" IsTabStop="False" CommandParameter="3">
                                    <Button.Content>
                                        <SymbolIcon Symbol="AlignRight"/>
                                    </Button.Content>
                                </Button>
                                <Button Click="AlignButton_Click" IsTabStop="False" CommandParameter="4">
                                    <Button.Content>
                                        <SymbolIcon Symbol="GlobalNavigationButton"/>
                                    </Button.Content>
                                </Button>
                            </VariableSizedWrapGrid>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <DropDownButton x:Name="FontColorButton" BorderThickness="0" Background="Transparent"
                                IsTabStop="False" RelativePanel.RightOf="AlignButton" RelativePanel.Below="TitleTextBox">
                    <SymbolIcon Symbol="FontColor"/>
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3">
                                <VariableSizedWrapGrid.Resources>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Width" Value="32"/>
                                        <Setter Property="Height" Value="32"/>
                                    </Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="MinWidth" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                        <Setter Property="Margin" Value="4"/>
                                    </Style>
                                </VariableSizedWrapGrid.Resources>
                                <Button Click="ColorButton_Click" IsTabStop="False" AutomationProperties.Name="Red">
                                    <Button.Content>
                                        <Rectangle Fill="Red"/>
                                    </Button.Content>
                                </Button>
                                <Button Click="ColorButton_Click" IsTabStop="False" AutomationProperties.Name="Orange">
                                    <Button.Content>
                                        <Rectangle Fill="Orange"/>
                                    </Button.Content>
                                </Button>
                                <Button Click="ColorButton_Click" IsTabStop="False" AutomationProperties.Name="Yellow">
                                    <Button.Content>
                                        <Rectangle Fill="Yellow"/>
                                    </Button.Content>
                                </Button>
                                <Button Click="ColorButton_Click" IsTabStop="False" AutomationProperties.Name="Green">
                                    <Button.Content>
                                        <Rectangle Fill="Green"/>
                                    </Button.Content>
                                </Button>
                                <Button Click="ColorButton_Click" IsTabStop="False" AutomationProperties.Name="Blue">
                                    <Button.Content>
                                        <Rectangle Fill="Blue"/>
                                    </Button.Content>
                                </Button>
                                <Button Click="ColorButton_Click" IsTabStop="False" AutomationProperties.Name="Indigo">
                                    <Button.Content>
                                        <Rectangle Fill="Indigo"/>
                                    </Button.Content>
                                </Button>
                                <Button Click="ColorButton_Click" IsTabStop="False" AutomationProperties.Name="Gray">
                                    <Button.Content>
                                        <Rectangle Fill="Gray"/>
                                    </Button.Content>
                                </Button>
                                <Button Click="ColorButton_Click" IsTabStop="False" AutomationProperties.Name="White">
                                    <Button.Content>
                                        <Rectangle Fill="White"/>
                                    </Button.Content>
                                </Button>
                                <Button Click="ColorButton_Click" IsTabStop="False" AutomationProperties.Name="Black">
                                    <Button.Content>
                                        <Rectangle Fill="Black"/>
                                    </Button.Content>
                                </Button>
                            </VariableSizedWrapGrid>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button Click="SaveButton_Click" Name="BtnSaveFile" IsTabStop="False" RelativePanel.AlignRightWith="NoteEditor" RelativePanel.Below="TitleTextBox">
                    <Button.Content>
                        <FontIcon Glyph="&#xE74E;"/>
                    </Button.Content>
                </Button>
                <!-- RichEditBox -->
                <RichEditBox
                x:Name="NoteEditor"
                GettingFocus="NoteEditor_GettingFocus"
                LosingFocus="NoteEditor_LosingFocus"
                ProcessKeyboardAccelerators="NoteEditor_ProcessKeyboardAccelerators"
                        VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                KeyboardAcceleratorPlacementMode="Hidden" 
                Width="auto"
                Height="auto"
                RelativePanel.Below="BoldButton"
                RelativePanel.Above="Search"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.AlignBottomWith="Search">
                    <RichEditBox.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="F" />
                    </RichEditBox.KeyboardAccelerators>
                </RichEditBox>

                <!-- Search StackPanel -->
                <StackPanel
                Name="Search"
                Orientation="Horizontal"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignBottomWithPanel="True"
                Margin="0,0,0,8">
                    <TextBlock x:Name="FindBoxLabel" l:Uids.Uid="NoteEditor_FindText" Height="20" />
                    <TextBox
                    x:Name="FindBox"
                    Width="240"
                    Margin="10,0,0,0"
                    TextChanged="FindBox_TextChanged"
                    GotFocus="FindBox_GotFocus"
                    LostFocus="FindBox_LostFocus" />
                </StackPanel>

                <!-- Spell Check CheckBox -->
                <CheckBox
                l:Uids.Uid="NoteEditor_SpellCheck"
                Name="SpellCheck"
                Checked="SpellCheck_Checked"
                Unchecked="SpellCheck_Unchecked"
                RelativePanel.AlignBottomWithPanel="True"
                RelativePanel.AlignRightWithPanel="True"
                Margin="0,0,0,8" />
            </RelativePanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton" Content="{x:Bind _Localizer.GetLocalizedString('Cancel')}" Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="{x:Bind _Localizer.GetLocalizedString('Save')}" Click="SaveButton_Click" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
