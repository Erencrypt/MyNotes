<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyNotes.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyNotes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:MyNotes.Helpers"
    xmlns:dev="using:DevWinUI"
    xmlns:controls="using:MyNotes.Views.Controls"
    xmlns:l="using:WinUI3Localizer"
    mc:Ignorable="d">
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>
    <RelativePanel Width="auto" Height="auto" HorizontalAlignment="Stretch">
        <Grid x:Name="topPanel"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignTopWithPanel="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="pageHeaderText" 
                           Grid.Row="0" Grid.Column="0" 
                            l:Uids.Uid="Settings_PageHeader"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="24"
                           >

            </TextBlock>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,-16,16"
                      RelativePanel.Below="topPanel"
                      RelativePanel.AlignLeftWithPanel="True"
                        RelativePanel.AlignRightWithPanel="True"
                        RelativePanel.AlignBottomWithPanel="True">
            <StackPanel x:Name="ContentArea" Margin="0,-30,12,0">
                <StackPanel MaxWidth="1000"
                            HorizontalAlignment="Stretch"
                            Spacing="{StaticResource SettingsCardSpacing}" Padding="0,16,0,0">

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                               l:Uids.Uid="Settings_Personalization" />

                    <controls:SettingsCard Name="ThemeCard" Icon="&#xE790;" l:Uids.Uid="Settings_Theme" Margin="0,0,0,4">
                        <ComboBox Name="ThemeCb"
                         Grid.Column="2"
                         Grid.RowSpan="2"
                         VerticalAlignment="Center"
                         Margin="4,0,12,0"
                         SelectionChanged="ThemeCb_SelectionChanged">
                            <ComboBoxItem l:Uids.Uid="Settings_Theme_Light" Content="Light" Tag="Light" />
                            <ComboBoxItem l:Uids.Uid="Settings_Theme_Dark" Content="Dark" Tag="Dark" />
                            <ComboBoxItem l:Uids.Uid="Settings_Theme_Default" Content="Default" Tag="Default" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Name="BackdropCard" Icon="&#xEF1F;" l:Uids.Uid="Settings_BackDrop">
                        <ComboBox Name="BackdropCb"
                            Grid.Column="2"
                            Grid.RowSpan="2"
                            VerticalAlignment="Center"
                            Margin="4,0,12,0"
                            SelectionChanged="BackdropCb_SelectionChanged">
                            <ComboBoxItem l:Uids.Uid="Settings_BackDrop_Base" Content="Mica" Tag="Mica" />
                            <ComboBoxItem l:Uids.Uid="Settings_BackDrop_BaseAlt" Content="Mica Alt" Tag="MicaAlt" />
                            <ComboBoxItem l:Uids.Uid="Settings_BackDrop_Acrylic" Content="Acrylic" Tag="Acrylic" />
                            <ComboBoxItem l:Uids.Uid="Settings_BackDrop_AcrylicThin" Content="Acrylic Thin" Tag="AcrylicThin" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                               l:Uids.Uid="Settings_Preferances"/>

                    <controls:SettingsCard Name="LanguageCard" Icon="&#xF2B7;" l:Uids.Uid="Settings_Language" Margin="0,0,0,4">
                        <ComboBox Name="LanguageCardCb" Margin="4,0,12,0" SelectionChanged="LanguageCardCb_SelectionChanged">
                            <ComboBoxItem Content="English" Tag="en-US"></ComboBoxItem>
                            <ComboBoxItem Content="Türkçe" Tag="tr-TR"></ComboBoxItem>
                            <ComboBoxItem Content="Deutsch" Tag="de-DE"></ComboBoxItem>
                            <ComboBoxItem Content="Français" Tag="fr-FR"></ComboBoxItem>
                            <ComboBoxItem Content="Italiano" Tag="it-IT"></ComboBoxItem>
                            <ComboBoxItem Content="Nederlands" Tag="nl-NL"></ComboBoxItem>
                            <ComboBoxItem Content="Українська" Tag="uk-UA"></ComboBoxItem>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Name="TimeFormatCard" Icon="&#xE823;" l:Uids.Uid="Settings_TimeFormat" Margin="0,0,0,4">
                        <ComboBox Name="TimeFormatCb" Margin="4,0,12,0" SelectionChanged="TimeFormatCb_SelectionChanged">
                            <ComboBoxItem l:Uids.Uid="Settings_TimeFormat_12" Content="12 Hour" Tag="TwelveHour" />
                            <ComboBoxItem l:Uids.Uid="Settings_TimeFormat_24" Content="24 Hour" Tag="TwentyFourHour"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Name="SaveCard" Icon="&#xE74E;" l:Uids.Uid="Settings_Save" Margin="0,0,0,4">
                        <ToggleSwitch Name="SaveTogle"
                            Toggled="SaveTogle_Toggled"
                            Grid.Column="2"
                            Grid.RowSpan="2"
                            VerticalAlignment="Center"
                            Margin="4,0,-64,0"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Name="StartupCard" Icon="&#xE777;" l:Uids.Uid="Settings_Startup" Margin="0,0,0,4">
                        <ToggleSwitch Name="StartupTogle"
                            Toggled="StartupTogle_Toggled"
                            Grid.Column="2"
                            Grid.RowSpan="2"
                            VerticalAlignment="Center"
                            Margin="4,0,-64,0"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Name="AlarmSoundLoopingCard" Icon="&#xE767;" l:Uids.Uid="Settings_AlarmSoundLooping" Margin="0,0,0,4">
                        <ToggleSwitch Name="AlarmSoundLoopingToggle"
                            Toggled="AlarmSoundLoopingToggle_Toggled"
                            Grid.Column="2"
                            Grid.RowSpan="2"
                            VerticalAlignment="Center"
                            Margin="4,0,-64,0"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Name="ReminderNotificationPriorityCard" Icon="&#xE7F4;" l:Uids.Uid="Settings_ReminderNotificationPriority" Margin="0,0,0,4">
                        <ComboBox Name="ReminderNotificationPriorityCb"
                            Margin="4,0,12,0"
                            SelectionChanged="ReminderNotificationPriorityCb_SelectionChanged">
                            <ComboBoxItem l:Uids.Uid="Settings_ReminderNotificationPriority_Default" Content="Default" Tag="Default"/>
                            <ComboBoxItem l:Uids.Uid="Settings_ReminderNotificationPriority_High" Content="High" Tag="High"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Name="TrashRetentionCard" Icon="&#xE74D;" l:Uids.Uid="Settings_TrashRetention">
                        <ComboBox Name="TrashRetentionCb"
                            Margin="4,0,12,0"
                            SelectionChanged="TrashRetentionCb_SelectionChanged">
                            <ComboBoxItem l:Uids.Uid="Settings_TrashRetention_5" Content="5 days" Tag="5"/>
                            <ComboBoxItem l:Uids.Uid="Settings_TrashRetention_15" Content="15 days" Tag="15"/>
                            <ComboBoxItem l:Uids.Uid="Settings_TrashRetention_30" Content="30 days" Tag="30"/>
                            <ComboBoxItem l:Uids.Uid="Settings_TrashRetention_45" Content="45 days" Tag="45"/>
                            <ComboBoxItem l:Uids.Uid="Settings_TrashRetention_60" Content="60 days" Tag="60"/>
                            <ComboBoxItem l:Uids.Uid="Settings_TrashRetention_90" Content="90 days" Tag="90"/>
                            <ComboBoxItem l:Uids.Uid="Settings_TrashRetention_Never" Content="Never" Tag="0"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" l:Uids.Uid="Settings_UpdatesHeader"/>

                    <controls:SettingsCard Name="CheckUpdatesNowCard" Icon="&#xEBD3;" l:Uids.Uid="Settings_CheckUpdatesNow">
                        <Button Name="CheckUpdatesNowButton"
                        Grid.Column="2"
                        Grid.RowSpan="2"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        l:Uids.Uid="CheckUpdatesNowButton"
                        Click="CheckUpdatesNowButton_Click"/>
                    </controls:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" l:Uids.Uid="Settings_AboutHeader"/>

                    <Expander Name="AboutSection"
                               Width="auto"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,0,4">
                        <Expander.Header>
                            <Grid VerticalAlignment="Stretch"
                                    Padding="2,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Height="24" VerticalAlignment="Center" Grid.RowSpan="2" Margin="-8,0,12,0">
                                    <Image.Source>
                                        <BitmapImage UriSource="ms-appx:///Assets/WindowIcon.ico" DecodePixelHeight="24"/>
                                    </Image.Source>
                                </Image>
                                <TextBlock Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Name="AppDescription"/>
                                <TextBlock Grid.Column="1"
                                        Grid.Row="1"
                                        Opacity="0.8"
                                        l:Uids.Uid="Settings_About"/>
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_AboutDescription" Width="auto" TextWrapping="WrapWholeWords" Margin="0,0,0,8"/>
                            <HyperlinkButton BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}" l:Uids.Uid="Settings_GitHubPage"/>
                        </StackPanel>
                    </Expander>

                    <controls:SettingsCard Name="ExitCard" Icon="&#xE7E8;" l:Uids.Uid="Settings_Exit">
                        <Button Name="ExitButton"
                        l:Uids.Uid="Settings_ExitButton"
                        Grid.Column="2"
                        Grid.RowSpan="2"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel MaxWidth="420">
                                        <TextBlock l:Uids.Uid="Settings_ExitFlyoutText" Name="ExitFlyoutText" Style="{ThemeResource BaseTextBlockStyle}" Margin="0,0,0,16" />
                                        <Button l:Uids.Uid="Settings_ExitButton" Name="ExitFlyoutButton" Click="ExitButton_Click"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </controls:SettingsCard>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </RelativePanel>
</Page>
