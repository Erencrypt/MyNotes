<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyNotes.Views.PlannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MyNotes.Data.Models"
    xmlns:viewmodels="using:MyNotes.ViewModels"
    xmlns:l="using:WinUI3Localizer"
    d:DataContext="{d:DesignInstance Type=viewmodels:PlannerViewModel}"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea" Width="auto">
        <RelativePanel Width="auto" Height="auto" HorizontalAlignment="Stretch">

            <!-- ── Top bar ── -->
            <Grid x:Name="topPanel"
                  RelativePanel.AlignRightWithPanel="True"
                  RelativePanel.AlignLeftWithPanel="True"
                  RelativePanel.AlignTopWithPanel="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="pageHeaderText"
                           l:Uids.Uid="Planner_PageHeader"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="24" />

                <Button x:Name="AddTaskListButton"
                        Grid.Column="1"
                        Click="AddTaskListButton_Click"
                        MinWidth="64"
                        Width="auto"
                        Style="{StaticResource DefaultButtonStyle}">
                    <FontIcon Glyph="&#xF8AA;" />
                </Button>
            </Grid>

            <ScrollView RelativePanel.Below="topPanel"
                        RelativePanel.AlignBottomWithPanel="True"
                        RelativePanel.AlignLeftWithPanel="True"
                        RelativePanel.AlignRightWithPanel="True"
                        HorizontalScrollMode="Disabled" Margin="0,12,-16,0">

                <ItemsRepeater x:Name="TaskListsRepeater"
                           RelativePanel.Below="topPanel"
                           RelativePanel.AlignLeftWithPanel="True"
                           RelativePanel.AlignRightWithPanel="True"
                           RelativePanel.AlignBottomWithPanel="True"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Margin="0,0,16,16"
                           ItemsSource="{x:Bind ViewModel.TaskLists, Mode=OneWay}">

                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                                        x:Name="uniformGridLayout"
                                        Orientation="Horizontal"
                                        ItemsStretch="Fill"
                                        MinItemWidth="273"
                                        MinItemHeight="210"
                                        MinColumnSpacing="12"
                                        MinRowSpacing="12"/>
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TaskListViewModel">
                            <Grid Padding="12"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  CornerRadius="{StaticResource ControlCornerRadius}"
                                  BorderThickness="1"
                                  BorderBrush="{StaticResource SurfaceStrokeColorDefaultBrush}"
                                  Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
                                  AllowDrop="True"
                                  Drop="OnColumnDrop"
                                  DragOver="OnDragOver"
                                  PointerEntered="TaskListGrid_PointerEntered"
                                  PointerExited="TaskListGrid_PointerExited">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Column header -->
                                <Border Grid.Row="0"
                                        BorderThickness="0,0,0,2"
                                        Margin="0,0,0,6"
                                        BorderBrush="{x:Bind HeaderColor, Converter={StaticResource HexColorToBrushConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel x:Name="TaskListLeftHeaderButtons"
                                                    Grid.Column="0"
                                                    Margin="0,0,4,0"
                                                    Orientation="Horizontal"
                                                    Visibility="Collapsed">
                                            <Button Height="27"
                                                    CornerRadius="4,0,0,0"
                                                    VerticalAlignment="Bottom"
                                                    Background="Transparent"
                                                    BorderThickness="1,1,1,0"
                                                    Padding="4,0"
                                                    Margin="0"
                                                    Click="OnMoveColumnLeftClick"
                                                    Tag="{x:Bind Id}"
                                                    ToolTipService.ToolTip="Move Left">
                                                <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                                            </Button>

                                            <Button Height="27"
                                                    CornerRadius="0,4,0,0"
                                                    VerticalAlignment="Bottom"
                                                    Background="Transparent"
                                                    BorderThickness="0,1,1,0"
                                                    Padding="4,0"
                                                    Margin="0"
                                                    Click="OnMoveColumnRightClick"
                                                    Tag="{x:Bind Id}"
                                                    ToolTipService.ToolTip="Move Right">
                                                <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                                            </Button>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Name}"
                                                   FontWeight="SemiBold"
                                                   Height="27"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" />

                                        <StackPanel x:Name="TaskListRightHeaderButtons"
                                                    Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Visibility="Collapsed">
                                            <Button Height="27"
                                                    VerticalAlignment="Bottom"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    CornerRadius="4,4,0,0"
                                                    Padding="8,0"
                                                    Click="OnEditTaskListButtonClick"
                                                    HorizontalContentAlignment="Center"
                                                    Tag="{x:Bind Id}">
                                                <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                            </Button>

                                            <Button Height="27"
                                                    VerticalAlignment="Bottom"
                                                    Background="Transparent"
                                                    CornerRadius="4,4,0,0"
                                                    BorderThickness="2,2,2,0"
                                                    Padding="6,0"
                                                    HorizontalContentAlignment="Center"
                                                    Tag="{x:Bind Id}"
                                                    Click="OnAddTaskButtonClick"
                                                    BorderBrush="{x:Bind HeaderColor, Converter={StaticResource HexColorToBrushConverter}}">
                                                <FontIcon Glyph="&#xF8AA;" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Task items — fills the fixed column height, scrolls internally on overflow -->
                                <ListView Grid.Row="1"
                                      ItemsSource="{x:Bind Items, Mode=OneWay}"
                                      VerticalAlignment="Stretch"
                                      Margin="-6,0,-6,0"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollMode="Enabled"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      CanDragItems="True"
                                      AllowDrop="True"
                                      DragItemsStarting="OnDragItemsStarting"
                                      DragOver="OnDragOver"
                                      Drop="OnDrop"
                                      Tag="{x:Bind}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TaskItem">
                                            <Grid BorderThickness="0,0,0,1"
                                                  BorderBrush="{StaticResource ControlFillColorDefaultBrush}"
                                                  PointerEntered="TaskItemGrid_PointerEntered"
                                                  PointerExited="TaskItemGrid_PointerExited">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Title}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,2,0,0"
                                                           TextWrapping="WrapWholeWords" />
                                                    <TextBlock Text="{x:Bind Text}"
                                                       Margin="0,0,0,6"
                                                       TextWrapping="WrapWholeWords" />
                                                </StackPanel>

                                                <StackPanel x:Name="ActionButtons"
                                                            Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            Visibility="Collapsed">
                                                    <Button HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Tag="{x:Bind}"
                                                            BorderThickness="0"
                                                            Margin="0"
                                                            Padding="6,8"
                                                            Click="OnEditTaskClicked"
                                                            Background="Transparent">
                                                        <FontIcon Glyph="&#xE70F;"
                                                                  FontSize="14" />
                                                    </Button>
                                                    <Button HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Click="OnDeleteTaskClicked"
                                                            Tag="{x:Bind}"
                                                            BorderThickness="0"
                                                            Margin="0"
                                                            Padding="6,8"
                                                            Background="Transparent">
                                                        <FontIcon Glyph="&#xE74D;"
                                                                  Foreground="#dc3545"
                                                                  FontSize="14" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollView>

        </RelativePanel>
    </Grid>
</Page>
