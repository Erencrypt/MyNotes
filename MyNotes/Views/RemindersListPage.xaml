<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyNotes.Views.RemindersListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MyNotes.ViewModels"
    xmlns:helpers="using:MyNotes.Helpers"
    d:DataContext="{d:DesignInstance Type=viewmodels:RemindersListViewModel}"
    xmlns:l="using:WinUI3Localizer"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:ReminderDateTimeConverter x:Key="ReminderDateTimeConverter"/>
    </Page.Resources>

    <Grid x:Name="ContentArea" Width="auto">
        <RelativePanel Width="auto" Height="auto" HorizontalAlignment="Stretch">
            <Grid x:Name="topPanel"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignTopWithPanel="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="pageHeaderText" 
                           Grid.Row="0" Grid.Column="0" 
                           l:Uids.Uid="Reminders_PageHeader"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="24"
                           >

                </TextBlock>
                <AutoSuggestBox Name="RemindersSearch"
                     TextChanged="RemindersSearch_TextChanged"
                     QueryIcon="Find"
                     Margin="0,0,0,0"
                     Width="200"
                     Grid.Row="0"
                     Grid.Column="1"
                     />

            </Grid>

            <ListView Width="auto" Name="LstReminders" DoubleTapped="LstReminders_DoubleTapped"
                SelectionChanged="LstReminders_SelectionChanged"
                CornerRadius="4"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.AlignTopWithPanel="True"
                RelativePanel.AlignBottomWithPanel="True"
                BorderThickness="1"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                Margin="0,48,0,64"
                ItemsSource="{Binding Reminders}">
                <ListView.Header>
                    <Grid BorderThickness="0,0,0,1"
                           BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                           Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                           CornerRadius="4,4,0,0"
                          Padding="12,4" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   l:Uids.Uid="Reminders_ListHeader"
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" 
                                   l:Uids.Uid="Reminders_ListDate"
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Right" 
                                   VerticalAlignment="Center"/>
                    </Grid>
                </ListView.Header>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition/>
                        <ReorderThemeTransition/>
                        <ContentThemeTransition/>
                        <RepositionThemeTransition/>
                        <EntranceThemeTransition IsStaggeringEnabled="False"/>
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid BorderThickness="0,0,0,1" BorderBrush="{StaticResource ControlFillColorDefaultBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{Binding IconGlyph}"
                                Grid.RowSpan="2"
                                FontSize="24"
                                Margin="0,0,-2,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                            <FontIcon Glyph="&#xEDAC;"
                                Grid.RowSpan="2"
                                Foreground="{StaticResource AccentFillColorTertiaryBrush}"
                                Visibility="{Binding Alarm}"
                                FontSize="16"
                                Width="16" Height="16"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="-8,8,0,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ReminderHeader}"
                                       Style="{ThemeResource BaseTextBlockStyle}"
                                       Margin="12,6,0,0"/>
                            <TextBlock Grid.Column="1"
                                      Grid.Row="1"
                                      Opacity="0.8"
                                      Text="{Binding ReminderText}"
                                      Style="{ThemeResource BodyTextBlockStyle}"
                                      Height="18"
                                      Margin="12,0,0,6"/>
                            <TextBlock Grid.Column="2"
                          Grid.RowSpan="2"
                          Opacity="0.9"
                          HorizontalAlignment="Right"
                          TextAlignment="Right"
                          VerticalAlignment="Center"
                          Text="{Binding Converter={StaticResource ReminderDateTimeConverter}}"
                          Style="{ThemeResource BaseTextBlockStyle}"
                          Margin="12,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Name="EmptyText"
                       l:Uids.Uid="Reminders_EmptyText"
                FontWeight="SemiLight"
                Visibility="Collapsed"
                Margin="0,128,0,0"
                FontSize="16"    
                HorizontalAlignment="Center"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignRightWithPanel="True"
                    />
            <Button 
              Name="newReminder"
              RelativePanel.AlignBottomWithPanel="True"
              RelativePanel.LeftOf="deleteReminder"
              MinWidth="250"
              Width="auto"
              Margin="0,0,0,16"
              Click="NewReminder_Click"
              Style="{StaticResource AccentButtonStyle}">
                <FontIcon Glyph="&#xF8AA;" />
            </Button>
            <Button 
              IsEnabled="False"
              Name="deleteReminder"
              RelativePanel.AlignBottomWithPanel="True"
              RelativePanel.AlignRightWithPanel="True"
              Width="auto"
              FocusVisualPrimaryBrush="Red"
              Margin="16,0,0,16">
                <FontIcon Glyph="&#xE74D;" />
                <Button.Flyout>
                    <Flyout x:Name="DeleteFlyout">
                        <StackPanel MaxWidth="420">
                            <TextBlock l:Uids.Uid="DeleteFlyout" Style="{ThemeResource BaseTextBlockStyle}" Margin="0,0,0,16" />
                            <Button l:Uids.Uid="DeleteConfirm" Click="DeleteReminder_Click"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </RelativePanel>
    </Grid>
</Page>
