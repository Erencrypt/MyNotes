<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyNotes.Views.TrashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:MyNotes.Helpers"
    xmlns:l="using:WinUI3Localizer"
    mc:Ignorable="d">
    <Page.Resources>
        <helpers:RtfToPlainTextConverter x:Key="RtfToPlainTextConverter" />
        <helpers:DateTimeConverter x:Key="DateTimeConverter"/>
        <helpers:DeletedTaskItemsCountConverter x:Key="DeletedTaskItemsCountConverter"/>
    </Page.Resources>

    <Grid x:Name="ContentArea" Width="auto" Padding="-12,-8">
        <RelativePanel Width="auto" Height="auto" HorizontalAlignment="Stretch" Margin="0" Padding="0">
            <Pivot Name="TrashPivot" Width="auto" 
                 RelativePanel.AlignLeftWithPanel="True"
                 RelativePanel.AlignRightWithPanel="True"
                 RelativePanel.AlignTopWithPanel="True"
                 RelativePanel.AlignBottomWithPanel="True"
                   Margin="0"
                   Padding="0">
                <!--Note list-->
                <PivotItem Padding="0,-40,0,0">
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock l:Uids.Uid="Trash_NotePivotHeader" FontWeight="SemiBold"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <RelativePanel Width="auto" Height="auto" HorizontalAlignment="Stretch" Margin="0,0,0,24" Padding="0">
                        <AutoSuggestBox Name="NotesSearch"
                                        TextChanged="NotesSearch_TextChanged"
                                        QueryIcon="Find"
                                        Margin="0,0,0,0"
                                        Width="200"
                                        RelativePanel.AlignBottomWithPanel="True"
                                        RelativePanel.AlignLeftWithPanel="True"
                            />
                        <ListView Width="auto" Name="LstNotes"
                                CornerRadius="4"
                                SelectionChanged="LstNotes_SelectionChanged"
                                RelativePanel.AlignLeftWithPanel="True"
                                RelativePanel.AlignRightWithPanel="True"
                                RelativePanel.AlignTopWithPanel="True"
                                RelativePanel.AlignBottomWithPanel="True"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                Margin="0,48,0,48"
                                ItemsSource="{Binding DeletedNotes}">
                            <ListView.Header>
                                <Grid BorderThickness="0,0,0,1"
                                      BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                      CornerRadius="4,4,0,0"
                                      Padding="12,4"
                                      >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               l:Uids.Uid="Trash_DeletedNotes"
                                               FontWeight="SemiBold" 
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" 
                                               l:Uids.Uid="Trash_DeletedDate"
                                               FontWeight="SemiBold" 
                                               HorizontalAlignment="Right" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition/>
                                    <ReorderThemeTransition/>
                                    <ContentThemeTransition/>
                                    <RepositionThemeTransition/>
                                    <EntranceThemeTransition IsStaggeringEnabled="False"/>
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid BorderThickness="0,0,0,1" BorderBrush="{StaticResource ControlFillColorDefaultBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8A5;"
                                            Grid.RowSpan="2"
                                            FontSize="24"
                                            Margin="0,0,-2,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"/>
                                        <FontIcon Glyph="&#xEDAC;"
                                            Grid.RowSpan="2"
                                            Foreground="{StaticResource AccentFillColorTertiaryBrush}"
                                            Visibility="{Binding HasReminders}"
                                            FontSize="16"
                                            Width="16" Height="16"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Left"
                                            Margin="-8,8,0,0"/>
                                        <TextBlock Grid.Column="1"
                                             Text="{Binding Title}"
                                             Style="{ThemeResource BaseTextBlockStyle}"
                                             Margin="12,6,0,0"/>
                                        <TextBlock Grid.Column="1"
                                             Grid.Row="1"
                                             Opacity="0.8"
                                             Text="{Binding Content, Converter={StaticResource RtfToPlainTextConverter}}"
                                             Style="{ThemeResource BodyTextBlockStyle}"
                                             Height="18"
                                             Margin="12,0,0,6"/>
                                        <TextBlock Grid.Column="2"
                                             Grid.RowSpan="2"
                                             Opacity="0.8"
                                             HorizontalAlignment="Right"
                                             TextAlignment="Right"
                                             VerticalAlignment="Center"
                                             Text="{Binding DeletedAt, Converter={StaticResource DateTimeConverter}}"
                                             Style="{ThemeResource BaseTextBlockStyle}"
                                             Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Name="EmptyText"
                                   l:Uids.Uid="Trash_TrashEmpty"
                                   FontWeight="SemiLight"
                                   Visibility="Collapsed"
                                   Margin="0,128,0,0"
                                   FontSize="16"    
                                   HorizontalAlignment="Center"
                                   RelativePanel.AlignLeftWithPanel="True"
                                   RelativePanel.AlignRightWithPanel="True" />  
                        <Button 
                              IsEnabled="False"
                              Name="RestoreNote"
                              RelativePanel.AlignBottomWithPanel="True"
                              RelativePanel.LeftOf="DeleteNote"
                              MinWidth="164"
                              Width="auto"
                              Click="RestoreNote_Click"
                              Style="{StaticResource AccentButtonStyle}">
                            <FontIcon Glyph="&#xE845;"/>
                        </Button>
                        <Button 
                              IsEnabled="False"
                              Name="DeleteNote"
                              RelativePanel.AlignBottomWithPanel="True"
                              RelativePanel.AlignRightWithPanel="True"
                              Width="auto"
                              FocusVisualPrimaryBrush="Red"
                              Margin="16,0,0,0">
                            <FontIcon Glyph="&#xE74D;" />
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel MaxWidth="420">
                                        <TextBlock Name="DeleteFlyoutNoteText" l:Uids.Uid="Trash_DeleteFlyout" Style="{ThemeResource BaseTextBlockStyle}" Margin="0,0,0,16" />
                                        <Button Name="DeleteNoteFlyout" l:Uids.Uid="DeleteConfirm" Click="DeleteNote_Click"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </RelativePanel>
                </PivotItem>
                <!--Reminder List-->
                <PivotItem Padding="0,-40,0,0">
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock l:Uids.Uid="Trash_ReminderPivotHeader" FontWeight="SemiBold"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <RelativePanel Width="auto" Height="auto" HorizontalAlignment="Stretch" Margin="0,0,0,24" Padding="0">
                        <AutoSuggestBox Name="RemindersSearch"
                                        TextChanged="RemindersSearch_TextChanged"
                                        QueryIcon="Find"
                                        Width="200"
                                        RelativePanel.AlignBottomWithPanel="True"
                                        RelativePanel.AlignLeftWithPanel="True"
                        />
                        <ListView Width="auto" Name="LstReminders"
                               SelectionChanged="LstReminders_SelectionChanged"
                               CornerRadius="4"
                               RelativePanel.AlignLeftWithPanel="True"
                               RelativePanel.AlignRightWithPanel="True"
                               RelativePanel.AlignTopWithPanel="True"
                               RelativePanel.AlignBottomWithPanel="True"
                               BorderThickness="1"
                               BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                               Margin="0,48,0,48"
                               ItemsSource="{Binding DeletedReminders}">
                            <ListView.Header>
                                <Grid BorderThickness="0,0,0,1"
                                      BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                      CornerRadius="4,4,0,0"
                                      Padding="12,4"
                                      >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"  
                                               l:Uids.Uid="Trash_DeletedReminders"
                                               FontWeight="SemiBold" 
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" 
                                               l:Uids.Uid="Trash_DeletedDate"
                                               FontWeight="SemiBold" 
                                               HorizontalAlignment="Right" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition/>
                                    <ReorderThemeTransition/>
                                    <ContentThemeTransition/>
                                    <RepositionThemeTransition/>
                                    <EntranceThemeTransition IsStaggeringEnabled="False"/>
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid BorderThickness="0,0,0,1" BorderBrush="{StaticResource ControlFillColorDefaultBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding IconGlyph}"
                                          Grid.RowSpan="2"
                                          FontSize="24"
                                          Margin="0,2,-2,2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                                        <FontIcon Glyph="&#xEDAC;"
                                                Grid.RowSpan="2"
                                                Foreground="{StaticResource AccentFillColorTertiaryBrush}"
                                                Visibility="{Binding Alarm}"
                                                FontSize="16"
                                                Width="14" Height="14"
                                                VerticalAlignment="Top"
                                                HorizontalAlignment="Left"
                                                Margin="-8,8,0,0"/>
                                        <TextBlock Grid.Column="1"
                                          Text="{Binding ReminderHeader}"
                                          Style="{ThemeResource BaseTextBlockStyle}"
                                          Margin="12,6,0,0"/>
                                        <TextBlock  Grid.Column="1"
                                          Grid.Row="1"
                                          Opacity="0.8"
                                          Text="{Binding ReminderText}"
                                          Style="{ThemeResource BodyTextBlockStyle}"
                                          Height="18"
                                          Margin="12,0,0,6"/>
                                        <TextBlock Grid.Column="2"
                                          Grid.RowSpan="2"
                                          Opacity="0.8"
                                          HorizontalAlignment="Right"
                                          TextAlignment="Right"
                                          VerticalAlignment="Center"
                                          Text="{Binding DeletedAt, Converter={StaticResource DateTimeConverter}}"
                                          Style="{ThemeResource BaseTextBlockStyle}"
                                          Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Name="EmptyText2"
                            FontWeight="SemiLight"
                                   l:Uids.Uid="Trash_TrashEmpty"
                            Visibility="Collapsed"
                            Margin="0,128,0,0"
                            FontSize="16"    
                            HorizontalAlignment="Center"
                            RelativePanel.AlignLeftWithPanel="True"
                            RelativePanel.AlignRightWithPanel="True"
                                />
                        <Button 
                              IsEnabled="False"
                              Name="RestoreReminder"
                              RelativePanel.AlignBottomWithPanel="True"
                              RelativePanel.LeftOf="DeleteReminder"
                              MinWidth="164"
                              Width="auto"
                              Click="RestoreReminder_Click"
                              Style="{StaticResource AccentButtonStyle}">
                            <FontIcon Glyph="&#xE845;"/>
                        </Button>
                        <Button 
                              IsEnabled="False"
                              Name="DeleteReminder"
                              RelativePanel.AlignBottomWithPanel="True"
                              RelativePanel.AlignRightWithPanel="True"
                              Width="auto"
                              FocusVisualPrimaryBrush="Red"
                              Margin="16,0,0,0">
                            <FontIcon Glyph="&#xE74D;" />
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel MaxWidth="420">
                                        <TextBlock Name="DeleteFlyoutReminderText" l:Uids.Uid="Trash_DeleteFlyout" Style="{ThemeResource BaseTextBlockStyle}" Margin="0,0,0,16" />
                                        <Button Name="DeleteReminderFlyout" l:Uids.Uid="DeleteConfirm" Click="DeleteReminder_Click"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </RelativePanel>
                </PivotItem>
                <!--Planner(Task List) List-->
                <PivotItem Padding="0,-40,0,0">
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock l:Uids.Uid="Trash_TaskListPivotHeader" FontWeight="SemiBold"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <RelativePanel Width="auto" Height="auto" HorizontalAlignment="Stretch" Margin="0,0,0,24" Padding="0">
                        <AutoSuggestBox Name="TaskListSearch"
                                        TextChanged="TaskListSearch_TextChanged"
                                        QueryIcon="Find"
                                        Margin="0,0,0,0"
                                        Width="200"
                                        RelativePanel.AlignBottomWithPanel="True"
                                        RelativePanel.AlignLeftWithPanel="True"
                            />
                        <ListView Width="auto" Name="LstTaskLists"
                                CornerRadius="4"
                                SelectionChanged="LstTaskLists_SelectionChanged"
                                RelativePanel.AlignLeftWithPanel="True"
                                RelativePanel.AlignRightWithPanel="True"
                                RelativePanel.AlignTopWithPanel="True"
                                RelativePanel.AlignBottomWithPanel="True"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                Margin="0,48,0,48"
                                ItemsSource="{Binding DeletedTaskLists}">
                            <ListView.Header>
                                <Grid BorderThickness="0,0,0,1"
                                      BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                      CornerRadius="4,4,0,0"
                                      Padding="12,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               l:Uids.Uid="Trash_DeletedTaskLists"
                                               FontWeight="SemiBold" 
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" 
                                               l:Uids.Uid="Trash_DeletedDate"
                                               FontWeight="SemiBold" 
                                               HorizontalAlignment="Right" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition/>
                                    <ReorderThemeTransition/>
                                    <ContentThemeTransition/>
                                    <RepositionThemeTransition/>
                                    <EntranceThemeTransition IsStaggeringEnabled="False"/>
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid BorderThickness="0,0,0,1" BorderBrush="{StaticResource ControlFillColorDefaultBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xF0E3;"
                                                Grid.RowSpan="2"
                                                FontSize="24"
                                                Margin="0,0,-2,0"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                 Text="{Binding Name}"
                                                 Style="{ThemeResource BaseTextBlockStyle}"
                                                 Margin="12,6,0,0"/>
                                        <TextBlock Grid.Column="1"
                                                 Grid.Row="1"
                                                 Opacity="0.8"
                                                 Text="{Binding DeletedTaskItemsCount, Converter={StaticResource DeletedTaskItemsCountConverter}}"
                                                 Style="{ThemeResource BodyTextBlockStyle}"
                                                 Height="18"
                                                 Margin="12,0,0,6"/>
                                        <TextBlock Grid.Column="2"
                                                 Grid.RowSpan="2"
                                                 Opacity="0.8"
                                                 HorizontalAlignment="Right"
                                                 TextAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding DeletedAt, Converter={StaticResource DateTimeConverter}}"
                                                 Style="{ThemeResource BaseTextBlockStyle}"
                                                 Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                            <TextBlock Name="EmptyText3"
                                       l:Uids.Uid="Trash_TrashEmpty"
                                       FontWeight="SemiLight"
                                       Visibility="Collapsed"
                                       Margin="0,128,0,0"
                                       FontSize="16"    
                                       HorizontalAlignment="Center"
                                       RelativePanel.AlignLeftWithPanel="True"
                                       RelativePanel.AlignRightWithPanel="True"
                                          />
                            <Button 
                                    IsEnabled="False"
                                    Name="RestoreTaskList"
                                    RelativePanel.AlignBottomWithPanel="True"
                                    RelativePanel.LeftOf="DeleteTaskList"
                                    MinWidth="164"
                                    Width="auto"
                                    Click="RestoreTaskList_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                <FontIcon Glyph="&#xE845;"/>
                            </Button>
                            <Button 
                                    IsEnabled="False"
                                    Name="DeleteTaskList"
                                    RelativePanel.AlignBottomWithPanel="True"
                                    RelativePanel.AlignRightWithPanel="True"
                                    Width="auto"
                                    FocusVisualPrimaryBrush="Red"
                                    Margin="16,0,0,0">
                                <FontIcon Glyph="&#xE74D;" />
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel MaxWidth="420">
                                            <TextBlock Name="DeleteFlyoutTaskListText" l:Uids.Uid="Trash_DeleteFlyout" Style="{ThemeResource BaseTextBlockStyle}" Margin="0,0,0,16" />
                                            <Button Name="DeleteTaskListFlyout" l:Uids.Uid="DeleteConfirm" Click="DeleteTaskList_Click"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                    </RelativePanel>
                </PivotItem>
            </Pivot>

        </RelativePanel>
    </Grid>
</Page>
